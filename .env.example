# Copy to .env, or just run ./scripts/setup.sh and it will ask for these.
# .env is gitignored and must stay that way.

# Quill licence key, from RavenDB. Read by the Quill container at boot, so it
# has to be present before the stack starts.
QUILL_LICENSE_KEY=QUILL-...

# Dashboard API key, created in the Quill dashboard. Server side only, it is
# never sent to a browser.
QUILL_API_KEY=QUILLDASH-...

# Model key. Must be a non-reasoning model, see "Choosing a model" in README.
OPENAI_API_KEY=sk-...

# Everything below is optional. The app discovers the domain from the
# certificate Quill serves, and the app slug, widget and agent from its API.
# Set them only to pin a specific app on an instance that hosts several.
# QUILL_DOMAIN=
# QUILL_APP_SLUG=
# QUILL_MODEL=gpt-5.3-chat-latest
